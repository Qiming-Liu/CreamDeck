    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "dlc",
    "steam"
  ],
  "author": "Qiming-Liu",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Qiming-Liu/CreamDeck/issues"
  },
  "homepage": "https://github.com/Qiming-Liu/CreamDeck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
