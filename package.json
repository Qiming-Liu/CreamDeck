{
  "name": "creamdeck",
  "version": "1.0.1",
  "description": "Decky Loader plugin porting CreamInstaller's Steam DLC unlocking to Steam Deck.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
